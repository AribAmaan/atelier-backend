datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id                  String      @id @default(uuid())
  email               String      @unique
  passwordHash        String
  googleId            String?     @unique // set once this account is linked to "Sign in with Google"
  displayName         String
  username            String?   @unique
  birthdate           DateTime
  tosAcceptedAt       DateTime
  emailVerified       Boolean   @default(false)
  highlights          String?   @db.Text
  avatarUrl           String?
  explicitMode        Boolean   @default(false)
  blurExplicitImages  Boolean   @default(false)
  defaultModel        String?   @default("default")
  preferredLanguage   String?   @default("en")
  // Billing (Razorpay) — inert until PAYMENTS_ENABLED=true, see lib/payments/razorpay.ts.
  sparkBalance        Int         @default(0) // in-app currency balance; credited when a spark_pack order is verified paid
  membershipTier      String      @default("free") // "free" | "plus" | "ultra" | "supreme"
  membershipRenewsAt  DateTime? // null for "free"; set to the next billing date when a membership order is verified paid
  createdAt           DateTime    @default(now())
  // Inactivity/data-retention lifecycle — see src/jobs/retentionCleanup.ts.
  // Bumped on every authenticated request (debounced, see src/lib/activity.ts).
  lastActiveAt          DateTime  @default(now())
  // Set when the "your account will be deleted soon" warning email goes out
  // (~1 month before deletion). Null again once dismissed by fresh activity.
  deletionWarningSentAt DateTime?
  // Set when this account has been anonymized by the retention job. Once set,
  // email/passwordHash/displayName have been scrubbed and the account is
  // treated as gone everywhere except the (deliberately preserved, anonymized)
  // PaymentOrder trail — see the job for why we don't hard-delete the row.
  deletedAt              DateTime?
  @@index([lastActiveAt])
  @@index([deletedAt])
  characters          Character[]
  messages            Message[]
  reports             Report[]    @relation("ReportsFiled")
  passwordResets      PasswordResetToken[]
  emailVerifications  EmailVerificationToken[]
  paymentOrders       PaymentOrder[]
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

model EmailVerificationToken {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

// A user-filed report against a public character card. Discover has separate
// SFW and explicit galleries, and both can be reported. Reports accumulate on the
// character and auto-hide it from Discover past a threshold pending review;
// an admin (see lib/admin.ts) can dismiss, keep-hidden, or delete.
model Report {
  id          String    @id @default(uuid())
  characterId String
  character   Character @relation(fields: [characterId], references: [id], onDelete: Cascade)
  reporterId  String
  reporter    User      @relation("ReportsFiled", fields: [reporterId], references: [id], onDelete: Cascade)
  reason      String
  note        String    @default("") @db.VarChar(2000)
  status      String    @default("open") // "open" | "dismissed" | "upheld"
  createdAt   DateTime  @default(now())

  @@index([characterId])
  @@index([status])
}

model Character {
  id                 String    @id @default(uuid())
  ownerId            String
  owner              User      @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  name               String
  tagline            String
  avatarEmoji        String    @default("🌸")
  avatarUrl          String? // path under /uploads if an image avatar was set
  backgroundUrl      String? // AI-generated or uploaded background/wallpaper image for the chat interface
  accentColor        String    @default("#c9a227")
  personality        String    @db.Text // short trait list, shown to the user
  backstory          String    @db.Text // longer context, injected into the model prompt
  greeting           String    @db.Text // first message the character opens with
  avatarPrompt       String    @default("") @db.VarChar(4000) // exact creator-specified visual/appearance description, used verbatim as the primary image-gen prompt for avatar + background + as the identity anchor for in-chat scene images
  scenePromptTemplate String   @default("") @db.VarChar(4000) // creator-specified art style / setting DNA reused across every in-chat scene image for visual consistency
  examples           String    @default("[]") @db.VarChar(8000) // JSON array of example dialogue turns [{user, character}], injected into prompt for character training
  tags               String    @default("[]") @db.VarChar(1000) // JSON array of searchable tags for discovery
  memorySummary      String    @default("") @db.VarChar(8000) // running summary of older conversation, folded in as memory
  summarizedThrough  Int       @default(0) // how many messages are already folded into memorySummary
  recallAfterCreatedAt DateTime? // oldest eligible transcript position after an explicit "forget memory"
  recallAfterId      String    @default("") @db.VarChar(191) // tie-breaker for messages created at the same instant
  isExplicit         Boolean   @default(false) // whether this is an explicit/NSFW character
  roleplayNotes      String    @default("") @db.VarChar(4000) // optional scenario hooks / boundaries for mature roleplay (private)
  isPublic           Boolean   @default(false) // shared to the discovery gallery for other users to remix
  flagCount          Int       @default(0) // number of open reports filed against this character
  isHidden           Boolean   @default(false) // auto-hidden from Discover pending moderation review, or hidden by an admin
  // Whether this user has ever sent a message to this character with explicit
  // mode on. Persists the relationship-level "explicit" bonus historically —
  // see computeRelationshipLevel() — instead of the old frontend-only
  // heuristic that re-derived it from the *current* toggle state on every
  // render (so it changed retroactively whenever the user flipped the
  // toggle, and reset on reload/another device since it was never stored).
  explicitEverUsed   Boolean   @default(false)
  // Set when this character was created via POST /:id/remix from another
  // public character. The remix is a full independent copy (see that route)
  // — this FK is purely for lineage/attribution ("Based on X by Y", remix
  // counts on Discover), never dereferenced for prompt/memory data.
  remixOfId          String?
  remixOf            Character?  @relation("Remixes", fields: [remixOfId], references: [id], onDelete: SetNull)
  remixes            Character[] @relation("Remixes")
  createdAt          DateTime  @default(now())
  messages           Message[]
  reports            Report[]

  @@index([ownerId])
  @@index([isPublic])
  @@index([remixOfId])
}

model Message {
  id          String    @id @default(uuid())
  characterId String
  character   Character @relation(fields: [characterId], references: [id], onDelete: Cascade)
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  role        String // "user" | "assistant"
  content     String    @db.Text
  createdAt   DateTime  @default(now())

  @@index([characterId, userId, createdAt])
  @@index([characterId, createdAt])
  @@index([userId, characterId, createdAt])
}

// One row per Razorpay order this app has created (spark-pack purchase or
// membership subscription). Created in "created" state when the checkout
// order is opened, flipped to "paid"/"failed" once /api/billing/verify (or
// the webhook) confirms the outcome. The whole billing route is a no-op
// while PAYMENTS_ENABLED is unset, so this table stays empty until that
// flag is flipped on — see lib/payments/razorpay.ts.
model PaymentOrder {
  id                String    @id @default(uuid())
  userId            String
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind              String // "spark_pack" | "membership"
  referenceId       String // spark pack id (e.g. "s1000") or membership tier id (e.g. "plus")
  billingCycle      String? // "monthly" | "quarterly" | "yearly" — only set for kind="membership"
  amountInPaise     Int
  currency          String    @default("INR")
  razorpayOrderId   String    @unique
  razorpayPaymentId String?
  status            String    @default("created") // "created" | "paid" | "failed"
  createdAt         DateTime  @default(now())
  paidAt            DateTime?

  @@index([userId])
  @@index([razorpayOrderId])
}
